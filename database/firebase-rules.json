
{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",

      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",

        ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.exists() && newData.child('uid').val() === auth.uid && newData.child('email').val() === auth.token.email && newData.child('role').val() === 'citizen' && newData.child('available').val() === false && newData.child('createdAt').isNumber()",

        ".validate": "newData.hasChildren(['uid', 'email', 'role', 'createdAt'])",

        "uid": {
          ".validate": "newData.isString() && newData.val() === $uid"
        },

        "email": {
          ".validate": "newData.isString()"
        },

        "role": {
          ".validate": "newData.val() === 'citizen' || newData.val() === 'responder' || newData.val() === 'admin'"
        },

        "createdAt": {
          ".validate": "newData.isNumber()"
        },

        "name": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString()"
        },

        "phone": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString()"
        },

        "address": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString()"
        },

        "city": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString()"
        },

        "state": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString()"
        },

        "emergencyContact": {
          ".write": "auth != null && auth.uid === $uid"
        },

        "profilePhoto": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString()"
        },

        "updatedAt": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isNumber()"
        },

        "latitude": {
          ".write": "auth != null && auth.uid === $uid && root.child('users').child(auth.uid).child('role').val() === 'responder'",
          ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
        },

        "longitude": {
          ".write": "auth != null && auth.uid === $uid && root.child('users').child(auth.uid).child('role').val() === 'responder'",
          ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
        }
      }
    },

    "incidents": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",

      "$incidentId": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || data.child('citizenId').val() === auth.uid || data.child('responderId').val() === auth.uid)",

        ".write": "auth != null && !data.exists() && newData.exists() && root.child('users').child(auth.uid).child('role').val() === 'citizen' && newData.child('citizenId').val() === auth.uid && newData.child('status').val() === 'reported' && !newData.child('responderId').exists()",

        ".validate": "newData.hasChildren(['citizenId', 'category', 'description', 'severity', 'status', 'createdAt'])",

        "citizenId": {
          ".validate": "newData.isString()"
        },

        "category": {
          ".validate": "newData.isString()"
        },

        "description": {
          ".validate": "newData.isString()"
        },

        "severity": {
          ".validate": "newData.val() === 'low' || newData.val() === 'medium' || newData.val() === 'high' || newData.val() === 'critical'"
        },

        "status": {
          ".validate": "newData.val() === 'reported' || newData.val() === 'assigned' || newData.val() === 'accepted' || newData.val() === 'on_the_way' || newData.val() === 'arrived' || newData.val() === 'resolved' || newData.val() === 'cancelled'"
        },

        "createdAt": {
          ".validate": "newData.isNumber()"
        }
      }
    },

    "responders": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",

      "$responderId": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (auth.uid === $responderId && root.child('users').child(auth.uid).child('role').val() === 'responder'))",

        ".write": false,

        ".validate": "newData.hasChildren(['userId', 'name', 'availability'])",

        "userId": {
          ".validate": "newData.isString()"
        },

        "name": {
          ".validate": "newData.isString()"
        },

        "availability": {
          ".write": "auth != null && auth.uid === $responderId && root.child('users').child(auth.uid).child('role').val() === 'responder'",
          ".validate": "newData.val() === 'available' || newData.val() === 'busy' || newData.val() === 'offline'"
        },

        "location": {
          "latitude": {
            ".write": "auth != null && auth.uid === $responderId && root.child('users').child(auth.uid).child('role').val() === 'responder'",
            ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
          },

          "longitude": {
            ".write": "auth != null && auth.uid === $responderId && root.child('users').child(auth.uid).child('role').val() === 'responder'",
            ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
          }
        }
      }
    },

    "notifications": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",

        "$notificationId": {
          ".write": false,

          ".validate": "newData.hasChildren(['title', 'message', 'createdAt', 'read'])",

          "title": {
            ".validate": "newData.isString()"
          },

          "message": {
            ".validate": "newData.isString()"
          },

          "createdAt": {
            ".validate": "newData.isNumber()"
          },

          "read": {
            ".write": "auth != null && auth.uid === $uid && data.exists() && newData.isBoolean()",
            ".validate": "newData.isBoolean()"
          }
        }
      }
    }
  }
}
