# ============================================================
# Smart Emergency Response - Git Ignore
# ============================================================

```gitignore
# Environment Variables
.env
.env.*
!.env.example

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
ENV/

# Python cache
.pytest_cache/
.mypy_cache/
.ruff_cache/

# IDE
.vscode/
.idea/
*.code-workspace

# Operating System
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*.swo

# Build / Cache
.cache/
dist/
build/
coverage/

# Firebase / Service Account Secrets
service-account*.json
firebase-adminsdk*.json
*-service-account.json

# Private Keys / Certificates
*.pem
*.key
*.crt

# Local Database
*.sqlite
*.sqlite3
*.db

# Local uploads / temporary data
uploads/
temp/
tmp/

# Keep example environment file
!.env.example
```
